---
import '../styles/global.css';
import BrandIcon from '../components/BrandIcon.astro';
import { evidenceChains } from '../lib/ergonomics';
import { relatedEpisode, relatedLinks } from '../lib/content';

const chains = Object.values(evidenceChains);
const isChinaDeployment = import.meta.env.SITE_REGION === 'cn';
const icpNumber = import.meta.env.PUBLIC_ICP_NUMBER?.trim();
const siteOrigin = isChinaDeployment ? 'https://fit.barrybarrywu.cn' : 'https://fit.barrybarrywu.com';
const shareImageUrl = `${siteOrigin}/brand/jiuwei-character.png`;
const classLabels = {
  'national-standard': '国家标准',
  'occupational-health': '职业健康指南',
  'professional-guidance': '专业校准指南',
  research: '研究说明',
};
---

<!doctype html>
<html lang="zh-Hans">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="输入身高，查看有出处的椅面、坐站桌与显示器设置建议。所有个人数据都只保存在浏览器中。" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icon.png" />
    <link rel="apple-touch-icon" href="/icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="就位｜找到适合你的桌椅与显示器高度" />
    <meta property="og:description" content="输入身高，查看有出处的椅面、坐站桌与显示器设置建议。" />
    <meta property="og:image" content={shareImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>就位｜找到适合你的桌椅与显示器高度</title>
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href="#calculator" aria-label="就位首页">
        <img class="wordmark-mark" src="/icon.png" alt="" width="28" height="28" />
        <span>就位</span>
      </a>
      <nav class="header-actions" aria-label="工具操作">
        <button id="replay-onboarding" type="button">使用说明</button>
        <span class="header-note">开源 · 数据留在本机</span>
      </nav>
    </header>

    <main>
      <section id="calculator" class="calculator-shell" aria-labelledby="page-title">
        <div class="control-panel">
          <div class="intro">
            <p class="eyebrow">WORKSTATION FIT</p>
            <h1 id="page-title" aria-label="按身高，调桌椅。">
              <span>按身高，</span><br />
              <span class="typewriter-line" aria-hidden="true">调桌椅。</span>
            </h1>
            <p class="hero-subtitle">输入身高，拿到适合你的椅子、桌子和屏幕高度。</p>
          </div>

          <aside class="calibration-callout" aria-labelledby="calibration-callout-title">
            <div>
              <p class="section-label">建议下一步</p>
              <h2 id="calibration-callout-title">30 秒身体校准</h2>
              <p id="calibration-summary">跟着脚掌、手肘和视线，检查坐姿的三个关键位置。</p>
            </div>
            <button id="start-calibration" class="primary-button" type="button">开始坐姿检查</button>
          </aside>

          <div class="height-control" data-onboarding-target="height">
            <div class="control-heading">
              <label for="height-number">你的身高</label>
              <div class="number-field">
                <input id="height-number" type="number" min="145" max="205" value="173" inputmode="numeric" />
                <span>cm</span>
              </div>
            </div>
            <input id="height-range" class="height-range" type="range" min="145" max="205" value="173" aria-label="身高，厘米" />
            <div class="range-ends" aria-hidden="true"><span>145</span><span>205</span></div>
          </div>

          <fieldset class="posture-switch" data-onboarding-target="posture">
            <legend class="sr-only">选择工作姿态</legend>
            <button class="posture-button is-active" type="button" data-posture="sitting" aria-pressed="true">坐着</button>
            <button class="posture-button" type="button" data-posture="standing" aria-pressed="false">站着</button>
            <span class="posture-indicator" aria-hidden="true"></span>
          </fieldset>

          <div id="calibration-panel" class="calibration-panel" hidden>
            <div>
              <p class="section-label">身体检查 <span id="calibration-progress"></span></p>
              <h2 id="calibration-title"></h2>
              <p id="calibration-instruction"></p>
            </div>
            <div class="calibration-actions">
              <button id="exit-calibration" type="button">稍后继续</button>
              <button id="next-calibration" class="primary-button" type="button">已调整，下一步</button>
            </div>
          </div>

          <div class="result-heading">
            <div>
              <p class="section-label">建议设置</p>
            </div>
            <span id="posture-caption">坐姿</span>
          </div>

          <div id="results" class="results" aria-live="polite"></div>
        </div>

        <div id="stage" class="stage" data-onboarding-target="scene" aria-label="可旋转的工位设置三维示意图">
          <canvas id="workstation-canvas"></canvas>
          <p class="stage-fallback" hidden>这台设备暂时无法显示 3D 场景，数值计算和身体检查不受影响。</p>
        </div>
      </section>

      <section id="evidence" class="content-section evidence-section" aria-labelledby="evidence-title">
        <div class="section-intro">
          <p class="eyebrow">EVIDENCE CHAINS</p>
          <h2 id="evidence-title">数值，怎么来的。</h2>
          <p>每项数值都列出原始资料和换算方式。品牌计算器与开源项目只作参考，不作为数值依据。</p>
        </div>
        <div class="evidence-browser">
          <div class="evidence-deck" aria-live="polite">
            {chains.map((chain, index) => (
              <article
                id={`evidence-${chain.id}`}
                class="evidence-card"
                role="tabpanel"
                aria-labelledby={`evidence-tab-${chain.id}`}
                tabindex="-1"
                hidden={index !== 0}
              >
              <header>
                <span class="evidence-number">{String(index + 1).padStart(2, '0')}</span>
                <div>
                  <h3>{chain.label}</h3>
                  <p>{chain.summary}</p>
                </div>
              </header>
              <dl>
                <div><dt>适用人群</dt><dd>{chain.population}</dd></div>
                <div><dt>来源覆盖</dt><dd>{chain.sourceCoverage ? `${chain.sourceCoverage.minHeight}–${chain.sourceCoverage.maxHeight} cm` : '与身高无关的通用指南'}</dd></div>
                <div><dt>采用数据</dt><dd>{chain.adoptedData}</dd></div>
                <div><dt>项目换算</dt><dd>{chain.transformation}</dd></div>
                <div><dt>覆盖外估算</dt><dd>{chain.extrapolation}</dd></div>
                <div><dt>局限</dt><dd>{chain.limitations}</dd></div>
              </dl>
              <div class="source-links" aria-label={`${chain.label}原始资料`}>
                {chain.sources.map((source) => (
                  <a href={source.url} target="_blank" rel="noreferrer">
                    <span>{classLabels[source.evidenceClass]}</span>
                    <strong>{source.organization}</strong>
                    <small>{source.title}</small>
                    <small>{source.versionOrPublished} · 核查于 {source.verifiedAt}</small>
                  </a>
                ))}
              </div>
              </article>
            ))}
          </div>

          <div class="evidence-navigation">
            <div class="evidence-index" role="tablist" aria-label="选择证据链">
              {chains.map((chain, index) => (
                <button
                  id={`evidence-tab-${chain.id}`}
                  type="button"
                  role="tab"
                  aria-controls={`evidence-${chain.id}`}
                  aria-selected={index === 0 ? 'true' : 'false'}
                  tabindex={index === 0 ? 0 : -1}
                  data-evidence-index={index}
                >
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  <strong>{chain.label}</strong>
                </button>
              ))}
            </div>
            <div class="evidence-pager" aria-label="证据链翻页">
              <button id="previous-evidence" type="button">上一项</button>
              <span id="evidence-progress" aria-live="polite">01 / {String(chains.length).padStart(2, '0')}</span>
              <button id="next-evidence" type="button">下一项</button>
            </div>
          </div>
        </div>
      </section>

      <section id="episode" class="content-section episode-section" aria-labelledby="episode-title">
        <div class="episode-copy">
          <p class="eyebrow">RELATED EPISODE</p>
          <h2 id="episode-title">{relatedEpisode.title}</h2>
          <p>{relatedEpisode.summary}</p>
          <div class="platform-links" aria-label="视频发布平台与本期商品链接">
            {relatedEpisode.destinations.map((destination) => destination.url ? (
              <a class:list={{ 'product-link-placeholder': destination.kind === 'product' }} href={destination.url} target="_blank" rel="noreferrer">
                <BrandIcon name={destination.icon} />
                <strong>{destination.label}</strong>
                <small>{destination.actionLabel ?? '观看'} ↗</small>
              </a>
            ) : (
              <span class:list={['is-pending', { 'product-link-placeholder': destination.kind === 'product' }]}>
                <BrandIcon name={destination.icon} />
                <strong>{destination.label}</strong>
                <small>{destination.pendingLabel ?? '待发布'}</small>
              </span>
            ))}
          </div>
        </div>
        <div class="episode-placeholder" role="img" aria-label="视频封面预留区域，十六比九">
          {relatedEpisode.cover ? (
            <img src={relatedEpisode.cover} alt={relatedEpisode.coverAlt} />
          ) : (
            <div class="safe-area"><span>16:9 封面预留</span><small>中央 4:3 安全区域</small></div>
          )}
        </div>
      </section>

      <section id="related-links" class="content-section related-links-section" aria-labelledby="related-links-title">
        <div class="section-intro">
          <p class="eyebrow">RELATED LINKS</p>
          <h2 id="related-links-title">发现更多。</h2>
          <p>看看作者更多好玩、好用的作品。</p>
        </div>
        <div class="related-link-grid">
          {relatedLinks.map((link) => (
            <a href={link.url} target="_blank" rel="noreferrer">
              <BrandIcon name={link.icon} />
              <div>
                <h3>{link.label}</h3>
                <p>{link.description}</p>
              </div>
              <span>{link.meta} ↗</span>
            </a>
          ))}
        </div>
      </section>

      <section id="independent-footer" class="independent-footer" aria-label="独立工具说明">
        <p>就位由 Barry 独立设计并开源。你的数据只保存在当前浏览器中，不会上传。</p>
        <div class="footer-legal">
          <p>这些结果只作为设置工位的起点，不能替代专业人体工学评估或医疗建议。</p>
          {isChinaDeployment && icpNumber && (
            <a href="https://beian.miit.gov.cn/" target="_blank" rel="noreferrer">{icpNumber}</a>
          )}
        </div>
      </section>
    </main>

    <dialog id="onboarding-dialog" class="onboarding-dialog" aria-labelledby="onboarding-title">
      <p class="eyebrow">快速使用说明</p>
      <h2 id="onboarding-title"></h2>
      <p id="onboarding-copy"></p>
      <div class="onboarding-actions">
        <button id="skip-onboarding" type="button">跳过</button>
        <span id="onboarding-progress"></span>
        <button id="next-onboarding" class="primary-button" type="button">下一步</button>
      </div>
    </dialog>

    <script src="../scripts/calculator.ts"></script>
    <script src="../scripts/evidence-browser.ts"></script>
  </body>
</html>
