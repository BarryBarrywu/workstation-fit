---
import type { BrandIconName } from '../lib/content';

type Props = {
  name: BrandIconName;
};

const { name } = Astro.props;
---

<span class={`brand-icon brand-icon-${name}`} aria-hidden="true">
  {name === 'bilibili' && (
    <svg viewBox="0 0 24 24" fill="none">
      <path d="m8.5 3 2 2m5-2-2 2M5.5 7.5h13A2.5 2.5 0 0 1 21 10v7.5a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 17.5V10a2.5 2.5 0 0 1 2.5-2.5Z" />
      <path d="M8.5 12.5v2m7-2v2" />
    </svg>
  )}
  {name === 'youtube' && (
    <svg viewBox="0 0 24 24" fill="none">
      <path fill="currentColor" d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8Z" />
      <path fill="#fff" d="m9.6 15.6 6.3-3.6-6.3-3.6v7.2Z" />
    </svg>
  )}
  {name === 'wechat' && (
    <svg viewBox="0 0 24 24" fill="none">
      <path fill="currentColor" d="M10.2 3C4.6 3 1 6.3 1 10.2c0 2.2 1.2 4.1 3.1 5.4l-.8 2.5 2.9-1.4c.8.2 1.6.4 2.5.4h.5a6.5 6.5 0 0 1-.3-1.9c0-3.9 3.6-7 8.2-7h.9C17 5.2 14 3 10.2 3Zm-3 4.7a1.1 1.1 0 1 1 0-2.2 1.1 1.1 0 0 1 0 2.2Zm6.1 0a1.1 1.1 0 1 1 0-2.2 1.1 1.1 0 0 1 0 2.2Z" />
      <path fill="currentColor" d="M23 15.1c0-3.3-3.1-5.9-6.9-5.9s-6.9 2.6-6.9 5.9 3.1 5.9 6.9 5.9c.7 0 1.4-.1 2.1-.3l2.2 1.1-.6-2a5.7 5.7 0 0 0 3.2-4.7Zm-9.2-1a.9.9 0 1 1 0-1.8.9.9 0 0 1 0 1.8Zm4.6 0a.9.9 0 1 1 0-1.8.9.9 0 0 1 0 1.8Z" />
    </svg>
  )}
  {name === 'douyin' && (
    <svg viewBox="0 0 24 24" fill="none">
      <path class="douyin-shadow-cyan" d="M14.2 3v11.2a4.7 4.7 0 1 1-3.8-4.6" />
      <path class="douyin-shadow-red" d="M15.7 2.5c.5 3.2 2.4 5.2 5.3 5.7" />
      <path d="M14.9 2.5v11.2a4.7 4.7 0 1 1-3.8-4.6m3.8-6.6c.5 3.2 2.4 5.2 5.3 5.7" />
    </svg>
  )}
  {name === 'xiaohongshu' && (
    <svg viewBox="0 0 24 24" fill="none">
      <rect width="24" height="24" rx="6" fill="currentColor" />
      <text x="12" y="13.8" fill="#fff" font-size="5.2" font-weight="700" text-anchor="middle">小红书</text>
    </svg>
  )}
  {name === 'placeholder' && (
    <span class="product-placeholder-mark"></span>
  )}
  {name === 'github' && (
    <svg viewBox="0 0 24 24" fill="currentColor">
      <path d="M12 .7a11.5 11.5 0 0 0-3.6 22.4c.6.1.8-.3.8-.6v-2.2c-3.4.7-4.1-1.4-4.1-1.4-.5-1.4-1.4-1.8-1.4-1.8-1.1-.8.1-.8.1-.8 1.3.1 1.9 1.3 1.9 1.3 1.1 1.9 2.9 1.4 3.6 1.1.1-.8.4-1.4.8-1.7-2.7-.3-5.5-1.3-5.5-5.8 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.6.1-3.1 0 0 1-.3 3.2 1.2A11 11 0 0 1 12 5.6c1 0 2 .1 2.9.4 2.2-1.5 3.2-1.2 3.2-1.2.6 1.5.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.5-2.8 5.5-5.5 5.8.4.4.8 1.1.8 2.2v3.4c0 .4.2.7.8.6A11.5 11.5 0 0 0 12 .7Z" />
    </svg>
  )}
  {name === 'tutti' && (
    <svg viewBox="0 0 128 128" fill="currentColor">
      <path d="M50.4 78.5a75.1 75.1 0 0 0-28.5 6.9l24.2-65.7c.7-2 1.9-3.2 3.4-3.2h29c1.5 0 2.7 1.2 3.4 3.2l24.2 65.7s-11.6-7-28.5-7L67 45.5c-.4-1.7-1.6-2.8-2.9-2.8-1.3 0-2.5 1.1-2.9 2.7L50.4 78.5Zm-5.3 8c-2 6.6-.6 15.8 4.2 20.2l.2-.7a5.5 5.5 0 0 1 5.7-4.5c2.8.1 4.3 1.5 4.7 4.7.2 1.1.2 2.3.2 3.5v.4c0 2.7.7 5.2 2.2 7.4a13 13 0 0 0 5.7 4.9v-.3l-.2-.3c-1.8-5.6-.5-9.5 4.4-12.8l1.5-1 3.2-2.2a16 16 0 0 0 6.8-11.4c.3-2 .1-4-.6-6l-.8.6-1.6 1a37 37 0 0 1-22.4 2.7c-5-.7-9.7-2-13.2-6.2Z" />
    </svg>
  )}
</span>
